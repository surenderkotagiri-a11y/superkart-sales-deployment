# Use an official lightweight Python runtime as a parent image
FROM python:3.10-slim

# Set the working directory in the container
WORKDIR /workspace

# Copy frontend specific dependencies list
COPY requirements_frontend.txt .

# Install the necessary UI libraries
RUN pip install --no-cache-dir -r requirements_frontend.txt

# Copy Streamlit application script
COPY app_frontend.py .

# Expose the default Streamlit application port 8501
EXPOSE 8501

# Run the Streamlit web service upon container startup
CMD ["streamlit", "run", "app_frontend.py", "--server.port=8501", "--server.address=0.0.0.0"]
